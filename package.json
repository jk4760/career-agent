{
  "name": "nextcareer",
  "private": true,
  "version": "0.5.0",
  "description": "NextCareer · 个人求职一站式平台（monorepo：web 前端 + api 后端 + db schema）",
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "dev:api": "npm run dev --workspace api",
    "seed": "npm run seed --workspace api",
    "migrate:generate": "npm run migrate:generate --workspace api"
  }
}
