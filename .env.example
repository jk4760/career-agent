# NextCareer 环境变量模板。复制为 .env 并填值；.env 绝不入库（.gitignore 已覆盖）。

# Postgres 容器内凭据（仅 compose 内网使用）
DB_PASSWORD=change-me-to-a-strong-password

# 全站 Basic Auth（nginx，未通过认证连页面都拿不到）
AUTH_USER=nextcareer
AUTH_PASS=change-me-to-a-strong-password

# 可选：web 对外端口（默认 80）
# WEB_PORT=80

# 模型用量预算（价格为非敏感配置，单位：元 / 100 万 tokens）
AI_DAILY_BUDGET_CNY=2
AI_BUDGET_ENFORCE=false
AI_PRICE_KIMI_K3_1_PRO_INPUT_CNY_PER_MTOK=13
AI_PRICE_KIMI_K3_1_PRO_OUTPUT_CNY_PER_MTOK=68
AI_PRICE_KIMI_K3_1_PRO_CACHE_HIT_CNY_PER_MTOK=1.30
AI_PRICE_KIMI_K3_1_PRO_CACHE_WRITE_5M_CNY_PER_MTOK=13
AI_PRICE_KIMI_K3_1_PRO_CACHE_WRITE_1H_CNY_PER_MTOK=26
AI_PRICE_KIMI_K3_1_PRO_HIGHSPEED_INPUT_CNY_PER_MTOK=26
AI_PRICE_KIMI_K3_1_PRO_HIGHSPEED_OUTPUT_CNY_PER_MTOK=136
AI_PRICE_KIMI_K3_1_PRO_HIGHSPEED_CACHE_HIT_CNY_PER_MTOK=1.30
AI_PRICE_KIMI_K3_1_PRO_HIGHSPEED_CACHE_WRITE_5M_CNY_PER_MTOK=26
AI_PRICE_KIMI_K3_1_PRO_HIGHSPEED_CACHE_WRITE_1H_CNY_PER_MTOK=52
